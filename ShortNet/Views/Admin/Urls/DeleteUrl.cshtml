@model ShortNet.Models.Url

@{
    ViewData["Title"] = "Delete URL";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Confirm URL Deletion</h4>
                <p>
                    Are you sure you want to delete this URL? <strong>This action cannot be undone.</strong>
                </p>
                <hr>
                <div class="mb-0">
                    <p><strong>Name:</strong> @Model.Name</p>
                    <p><strong>Short URL:</strong> <code>@Model.ShortUrl</code></p>
                    <p><strong>Long URL:</strong> @Model.LongUrl</p>
                    <p><strong>Created By:</strong> @Model.CreatedBy</p>
                    <p><strong>Created At:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                </div>
            </div>

            <form method="post" action="@Url.Action("DeleteUrl", "Admin", new { id = Model.Id })">
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Yes, Delete URL</button>
                    <a href="@Url.Action("Urls")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
