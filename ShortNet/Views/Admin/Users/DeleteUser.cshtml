@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Confirm User Deletion</h4>
                <p>
                    Are you sure you want to delete this user? <strong>This action cannot be undone.</strong>
                </p>
                <hr>
                <p class="mb-0">
                    <strong>User:</strong> @Model.Email (@Model.UserName)<br />
                    All URLs created by this user will also be deleted.
                </p>
            </div>

            <form method="post" action="@Url.Action("DeleteUser", "Admin", new { id = Model.Id })">
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Yes, Delete User</button>
                    <a href="@Url.Action("Users")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
