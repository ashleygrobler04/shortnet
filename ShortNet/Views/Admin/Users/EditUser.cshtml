@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    var userRoles = (List<string>?)ViewData["UserRoles"] ?? new List<string>();
    var availableRoles = (string[]?)ViewData["AvailableRoles"] ?? Array.Empty<string>();
    ViewData["Title"] = "Edit User";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Edit User Roles</h1>
            <hr />

            <div class="form-group mb-3">
                <label class="form-label"><strong>Email:</strong></label>
                <input type="text" class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="form-group mb-3">
                <label class="form-label"><strong>Username:</strong></label>
                <input type="text" class="form-control" value="@Model.UserName" disabled />
            </div>

            <form method="post">
                <div class="form-group mb-3">
                    <label class="form-label"><strong>Assign Roles:</strong></label>
                    <div class="mt-3">
                        @foreach (var role in availableRoles)
                        {
                            var isChecked = userRoles.Contains(role);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="role_@role" name="roles" value="@role" @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="role_@role">
                                    @role
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div class="alert alert-danger">
                        <strong>Error!</strong>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="@Url.Action("Users")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
